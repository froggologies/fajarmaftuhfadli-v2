---
interface Props {
  mode?: "perlin-flow-field" | "simplex" | "vortex";
  dotSpacing?: number;
  dotRadius?: number;
  speed?: number;
  mouseRadius?: number;
  mousePush?: number;
  mouseSpeed?: number;
  opacityMultiplier?: number;
  patternScale?: number;
}

const {
  mode = "perlin-flow-field",
  dotSpacing = 18,
  dotRadius = 1.0,
  speed = 0.0006,
  mouseRadius = 180,
  mousePush = 22,
  mouseSpeed = 0.3,
  opacityMultiplier = 1.0,
  patternScale = 1.0,
} = Astro.props;
---

<canvas
  id="dot-grid-bg"
  data-mode={mode}
  data-dot-spacing={dotSpacing}
  data-dot-radius={dotRadius}
  data-speed={speed}
  data-mouse-radius={mouseRadius}
  data-mouse-push={mousePush}
  data-mouse-speed={mouseSpeed}
  data-opacity-multiplier={opacityMultiplier}
  data-pattern-scale={patternScale}
  aria-hidden="true"></canvas>

<style>
  #dot-grid-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.75;
  }
</style>

<script>
  import { drawPerlinFlowField } from "../lib/noise/perlinFlowFieldMode";
  import { drawSimplex } from "../lib/noise/simplexMode";
  import { drawVortex } from "../lib/noise/vortexMode";

  const canvas = document.getElementById("dot-grid-bg") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  // Read config from dataset
  const dataset = canvas.dataset;
  const mode = dataset.mode;

  const config = {
    dotSpacing: Number(dataset.dotSpacing) || 18,
    dotRadius: Number(dataset.dotRadius) || 1.0,
    speed: Number(dataset.speed) || 0.0006,
    mouseRadius: Number(dataset.mouseRadius) || 180,
    mousePush: Number(dataset.mousePush) || 22,
    mouseSpeed: Number(dataset.mouseSpeed) || 0.3,
    opacityMultiplier: Number(dataset.opacityMultiplier) || 1.0,
    patternScale: Number(dataset.patternScale) || 1.0,
  };

  let W = 0,
    H = 0,
    cols = 0,
    rows = 0,
    time = 0;

  // ─── Mouse Interaction ──────────────────────────────────────────────────────
  let mouse = { x: 0, y: 0, targetX: 0, targetY: 0, active: false };

  window.addEventListener("mousemove", (e) => {
    mouse.targetX = e.clientX;
    mouse.targetY = e.clientY;
    if (!mouse.active) {
      mouse.x = mouse.targetX;
      mouse.y = mouse.targetY;
    }
    mouse.active = true;
  });

  window.addEventListener("mouseleave", () => {
    mouse.active = false;
  });

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    cols = Math.ceil(W / config.dotSpacing) + 2;
    rows = Math.ceil(H / config.dotSpacing) + 2;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    time += config.speed;

    // Lerp mouse coordinates using mouseSpeed parameter
    if (mouse.active) {
      mouse.x += (mouse.targetX - mouse.x) * config.mouseSpeed;
      mouse.y += (mouse.targetY - mouse.y) * config.mouseSpeed;
    }

    if (mode === "perlin-flow-field") {
      drawPerlinFlowField(ctx, cols, rows, time, config, mouse);
    } else if (mode === "simplex") {
      drawSimplex(ctx, cols, rows, time, config, mouse);
    } else if (mode === "vortex") {
      drawVortex(ctx, cols, rows, time, config, mouse);
    }

    requestAnimationFrame(draw);
  }

  window.addEventListener("resize", resize);
  resize();
  draw();
</script>
